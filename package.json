{
  "name": "h3x-searcher-v2",
  "version": "0.2.0",
  "private": true,
  "description": "H3X Searcher Windows OSINT workspace",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test electron/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.h3x.searcher.v2",
    "productName": "H3X Searcher",
    "files": ["dist/**/*", "electron/**/*", "package.json", "!electron/*.test.cjs"],
    "directories": {"output": "release"},
    "win": {"target": "nsis", "signAndEditExecutable": false, "artifactName": "H3X-Searcher-Setup-${version}-${arch}.${ext}"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "uninstallDisplayName": "H3X Searcher"}
  }
}
